# ---------------------------------------------------------------- backend
target/
!.mvn/wrapper/maven-wrapper.jar

# O banco H2 de desenvolvimento. São ~96 MB de dados de teste que o sistema
# recria sozinho no primeiro start, importando as tabelas de referência.
data/
*.mv.db
*.trace.db

# ---------------------------------------------------------------- frontend
node_modules/
dist/
.vite/
*.local

# Cache incremental do compilador do TypeScript: e derivado, muda a cada
# build e nao diz nada a quem le o historico.
*.tsbuildinfo

# --------------------------------------------------------------- ambiente
.env
.env.*
!.env.example

# ------------------------------------------------------------------ editor
.idea/
*.iml
.vscode/
*.swp
.DS_Store
Thumbs.db

# ------------------------------------------------------------------ saídas
*.log
/scratchpad/

# ------------------------------------------------------------------- testes
# Artefatos de execução do Playwright: rastro, vídeo e captura de cada falha.
# São derivados e pesados, e só dizem respeito à máquina que rodou a suíte.
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.playwright/

# A tela compilada dentro do JAR. Quem gera é o Dockerfile, copiando o dist/
# do front para cá. É artefato de build, e commitá-lo poria duas versões da
# mesma tela no repositório — a do código e a que alguém compilou um dia.
backend/src/main/resources/static/
